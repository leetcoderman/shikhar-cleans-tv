+package com.corvofeng.fakeatv
+
+import android.os.SystemClock
+import android.view.InputDevice
+import android.view.InputEvent
+import android.view.KeyCharacterMap
+import android.view.KeyEvent
+import android.view.MotionEvent
+import java.lang.reflect.Method
+
+/**
+ * Key injector run as the ADB shell user, started once per connection by [LocalAdbDriver]:
+ * `CLASSPATH=<apk> app_process / com.corvofeng.fakeatv.Injector`. `input keyevent` starts a new
+ * Java runtime for every key, which takes about 0.9 s on the DPL panel; this one stays up and
+ * injects each key in a few milliseconds.
+ *
+ * Reads one command per line on stdin and never runs anything else:
+ * - `k <keycode>`: press and release one key
+ * - `t <text>`: type printable ASCII, one character at a time
+ * - `d <count>`: press Delete count times
+ * - `c <x> <y>`: tap the screen at x, y (cursor mode)
+ * - `s <x1> <y1> <x2> <y2> <ms>`: drag from one point to another (cursor mode scrolling)
+ */
+object Injector {
+    const val READY = "FAKEATV_INJECTOR_READY"
+
+    private const val INJECT_MODE_ASYNC = 0
+    private const val CHAR_GAP_MS = 15L
+
+    private lateinit var inputManager: Any
+    private lateinit var inject: Method
+
+    @JvmStatic
+    fun main(args: Array<String>) {
