+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn top_object<'a>(archive: &'a Dictionary, key: &str) -> &'a Value {
+        let objects = archive.get("$objects").unwrap().as_array().unwrap();
+        let uid = archive.get("$top").unwrap().as_dictionary().unwrap().get(key).unwrap();
+        match uid {
+            Value::Uid(u) => &objects[u.get() as usize],
+            _ => panic!("not a UID"),
+        }
+    }
+
+    #[test]
+    fn session_archive_has_uuid_and_text() {
+        let focus = TextFocus { session_uuid: *b"0123456789abcdef", text: "star".into() };
+        let bytes = encode_session(&focus);
+        let archive = Value::from_reader(std::io::Cursor::new(&bytes)).unwrap();
+        let archive = archive.as_dictionary().unwrap();
+        assert_eq!(top_object(archive, "sessionUUID").as_data().unwrap(), b"0123456789abcdef");
+
+        let objects = archive.get("$objects").unwrap().as_array().unwrap();
+        assert_eq!(objects[0].as_string(), Some("$null"));
+        let resolve = |v: &Value| match v {
+            Value::Uid(u) => objects[u.get() as usize].clone(),
+            o => o.clone(),
+        };
+        let state = top_object(archive, "documentState").as_dictionary().unwrap();
+        let doc_st = resolve(state.get("docSt").unwrap());
+        let text = resolve(doc_st.as_dictionary().unwrap().get("contextBeforeInput").unwrap());
+        assert_eq!(text.as_string(), Some("star"));
+        let traits = top_object(archive, "documentTraits").as_dictionary().unwrap();
+        let class = resolve(traits.get("$class").unwrap());
+        assert_eq!(
+            class.as_dictionary().unwrap().get("$classname").unwrap().as_string(),
+            Some("RTIDocumentTraits")
+        );
+    }
+
+    /// The same shape pyatv sends to a real Apple TV for "insert text".
+    fn insertion_archive(text: &str) -> Vec<u8> {
+        let mut a = Archive::new();
+        let (ops_index, ops) = a.reserve();
+        let insertion = a.add(Value::String(text.into()));
+        let out_class = a.class("TIKeyboardOutput", &[]);
+        let output = a.add(dict(vec![("insertionText", insertion), ("$class", out_class)]));
+        let uuid_class = a.class("NSUUID", &[]);
+        let uuid = a.add(dict(vec![
+            ("NS.uuidbytes", Value::Data(b"0123456789abcdef".to_vec())),
+            ("$class", uuid_class),
+        ]));
+        let ops_class = a.class("RTITextOperations", &[]);
+        a.objects[ops_index] = dict(vec![
+            ("keyboardOutput", output),
+            ("targetSessionUUID", uuid),
+            ("$class", ops_class),
+        ]);
+        a.finish(vec![("textOperations", ops)])
+    }
+
+    #[test]
+    fn decodes_insertion() {
+        let op = decode_operation(&insertion_archive("hello world")).unwrap();
+        assert_eq!(op.insertion, "hello world");
+        assert_eq!(op.deletion_count, 0);
+        assert_eq!(op.session_uuid.as_deref(), Some(&b"0123456789abcdef"[..]));
+    }
+
+    #[test]
+    fn decodes_deletion_and_assert() {
+        let mut a = Archive::new();
+        let (ops_index, ops) = a.reserve();
+        let out_class = a.class("TIKeyboardOutput", &[]);
+        let output = a.add(dict(vec![
+            ("deletionCount", Value::Integer(2.into())),
+            ("$class", out_class),
+        ]));
+        let assert_text = a.add(Value::String("st".into()));
+        let ops_class = a.class("RTITextOperations", &[]);
+        a.objects[ops_index] = dict(vec![
+            ("keyboardOutput", output),
+            ("textToAssert", assert_text),
+            ("$class", ops_class),
+        ]);
+        let op = decode_operation(&a.finish(vec![("textOperations", ops)])).unwrap();
+        assert_eq!(op.deletion_count, 2);
+        assert_eq!(op.text_to_assert.as_deref(), Some("st"));
+    }
+
+    #[test]
+    fn decodes_accepted_candidate() {
+        let mut a = Archive::new();
+        let (ops_index, ops) = a.reserve();
+        let candidate_text = a.add(Value::String("hello".into()));
+        let typed = a.add(Value::String("hel".into()));
+        let candidate_class = a.class("TIKeyboardCandidateSingle", &["TIKeyboardCandidate"]);
+        let candidate = a.add(dict(vec![
+            ("candidate", candidate_text),
+            ("input", typed),
+            ("$class", candidate_class),
+        ]));
+        let out_class = a.class("TIKeyboardOutput", &[]);
+        let output = a.add(dict(vec![("acceptedCandidate", candidate), ("$class", out_class)]));
+        let ops_class = a.class("RTITextOperations", &[]);
+        a.objects[ops_index] = dict(vec![("keyboardOutput", output), ("$class", ops_class)]);
+        let op = decode_operation(&a.finish(vec![("textOperations", ops)])).unwrap();
+        assert_eq!(op.insertion, "hello");
+        assert_eq!(op.deletion_count, 3);
+        assert!(op.fields.contains(&"acceptedCandidate.candidate=5".to_string()));
+    }
+
+    #[test]
+    fn garbage_is_rejected() {
+        assert!(decode_operation(b"not a plist").is_none());
+    }
+}
