+// Adapted from Shizuku's ADB client (https://github.com/RikkaApps/Shizuku, v13.6.0,
+// manager/src/main/java/moe/shizuku/manager/adb), Copyright RikkaApps, Apache License 2.0.
+// Changes: one long-lived shell stream with a reader thread, the key kept in app-private files
+// instead of the Android Keystore, and a one-shot mDNS lookup of this device's own TLS port.
+package com.corvofeng.fakeatv
+
+import android.content.Context
+import android.net.nsd.NsdManager
+import android.net.nsd.NsdServiceInfo
+import android.util.Base64
+import android.util.Log
+import org.bouncycastle.asn1.x500.X500Name
+import org.bouncycastle.asn1.x509.SubjectPublicKeyInfo
+import org.bouncycastle.cert.X509v3CertificateBuilder
+import org.bouncycastle.operator.jcajce.JcaContentSignerBuilder
+import java.io.ByteArrayInputStream
+import java.io.Closeable
+import java.io.DataInputStream
+import java.io.DataOutputStream
+import java.io.File
+import java.io.IOException
+import java.math.BigInteger
+import java.net.InetSocketAddress
+import java.net.NetworkInterface
+import java.net.Socket
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import java.security.KeyFactory
+import java.security.KeyPairGenerator
+import java.security.Principal
+import java.security.PrivateKey
+import java.security.SecureRandom
+import java.security.cert.CertificateFactory
+import java.security.cert.X509Certificate
+import java.security.interfaces.RSAPrivateKey
+import java.security.interfaces.RSAPublicKey
+import java.security.spec.PKCS8EncodedKeySpec
+import java.security.spec.RSAKeyGenParameterSpec
+import java.security.spec.RSAPublicKeySpec
+import java.util.Date
+import java.util.Locale
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.Semaphore
+import java.util.concurrent.TimeUnit
+import javax.crypto.Cipher
+import javax.net.ssl.SSLContext
+import javax.net.ssl.SSLEngine
+import javax.net.ssl.SSLSocket
+import javax.net.ssl.X509ExtendedKeyManager
+import javax.net.ssl.X509ExtendedTrustManager
+
+private const val A_CNXN = 0x4e584e43
+private const val A_AUTH = 0x48545541
+private const val A_OPEN = 0x4e45504f
+private const val A_OKAY = 0x59414b4f
+private const val A_CLSE = 0x45534c43
+private const val A_WRTE = 0x45545257
+private const val A_STLS = 0x534C5453
+private const val A_VERSION = 0x01000000
+private const val A_MAXDATA = 4096
+private const val A_STLS_VERSION = 0x01000000
+private const val ADB_AUTH_TOKEN = 1
+private const val ADB_AUTH_SIGNATURE = 2
+private const val ADB_AUTH_RSAPUBLICKEY = 3
+
+/** The app's own ADB key: one RSA key for plain ADB auth and for the Wireless debugging TLS handshake. */
+class AdbKey(dir: File, private val name: String) {
+
+    private val privateKey: RSAPrivateKey
+    private val publicKey: RSAPublicKey
+    private val certificate: X509Certificate
+
+    init {
+        dir.mkdirs()
+        val file = File(dir, FILE_NAME)
+        val loaded = if (file.exists()) {
+            try {
+                KeyFactory.getInstance("RSA")
+                    .generatePrivate(PKCS8EncodedKeySpec(file.readBytes())) as RSAPrivateKey
+            } catch (e: Exception) {
+                null
+            }
+        } else null
+        privateKey = loaded ?: KeyPairGenerator.getInstance("RSA").run {
+            initialize(RSAKeyGenParameterSpec(2048, RSAKeyGenParameterSpec.F4))
+            generateKeyPair().private as RSAPrivateKey
+        }.also {
+            val tmp = File(dir, "tls_adbkey.tmp")
+            tmp.writeBytes(it.encoded)
+            tmp.renameTo(file)
+        }
+        publicKey = KeyFactory.getInstance("RSA")
+            .generatePublic(RSAPublicKeySpec(privateKey.modulus, RSAKeyGenParameterSpec.F4)) as RSAPublicKey
+
+        val signer = JcaContentSignerBuilder("SHA256withRSA").build(privateKey)
+        val cert = X509v3CertificateBuilder(
+            X500Name("CN=00"), BigInteger.ONE, Date(0), Date(2461449600 * 1000), Locale.ROOT,
+            X500Name("CN=00"), SubjectPublicKeyInfo.getInstance(publicKey.encoded)
+        ).build(signer)
+        certificate = CertificateFactory.getInstance("X.509")
+            .generateCertificate(ByteArrayInputStream(cert.encoded)) as X509Certificate
+    }
+
+    val adbPublicKey: ByteArray by lazy { publicKey.adbEncoded(name) }
+
+    fun sign(data: ByteArray?): ByteArray {
+        val cipher = Cipher.getInstance("RSA/ECB/NoPadding")
+        cipher.init(Cipher.ENCRYPT_MODE, privateKey)
+        cipher.update(PADDING)
+        return cipher.doFinal(data)
+    }
+
+    val sslContext: SSLContext by lazy {
+        SSLContext.getInstance("TLSv1.3").apply {
+            init(arrayOf(keyManager), arrayOf(trustManager), SecureRandom())
+        }
+    }
+
+    private val keyManager = object : X509ExtendedKeyManager() {
+        override fun chooseClientAlias(keyTypes: Array<out String>, issuers: Array<out Principal>?, socket: Socket?) =
+            if (keyTypes.contains("RSA")) "key" else null
+        override fun getCertificateChain(alias: String?) = if (alias == "key") arrayOf(certificate) else null
+        override fun getPrivateKey(alias: String?): PrivateKey? = if (alias == "key") privateKey else null
+        override fun getClientAliases(keyType: String?, issuers: Array<out Principal>?): Array<String>? = null
+        override fun getServerAliases(keyType: String, issuers: Array<out Principal>?): Array<String>? = null
+        override fun chooseServerAlias(keyType: String, issuers: Array<out Principal>?, socket: Socket?): String? = null
+    }
+
+    // The peer is this TV's own adbd on 127.0.0.1; adbd checks our certificate, not the other way round.
+    private val trustManager = object : X509ExtendedTrustManager() {
+        override fun checkClientTrusted(chain: Array<out X509Certificate>?, authType: String?, socket: Socket?) {}
+        override fun checkClientTrusted(chain: Array<out X509Certificate>?, authType: String?, engine: SSLEngine?) {}
+        override fun checkClientTrusted(chain: Array<out X509Certificate>?, authType: String?) {}
+        override fun checkServerTrusted(chain: Array<out X509Certificate>?, authType: String?, socket: Socket?) {}
+        override fun checkServerTrusted(chain: Array<out X509Certificate>?, authType: String?, engine: SSLEngine?) {}
+        override fun checkServerTrusted(chain: Array<out X509Certificate>?, authType: String?) {}
+        override fun getAcceptedIssuers(): Array<X509Certificate> = emptyArray()
+    }
+
+    companion object {
+        const val FILE_NAME = "tls_adbkey"
+
+        private val PADDING = byteArrayOf(
+            0x00, 0x01, *ByteArray(218) { -1 }, 0x00,
+            0x30, 0x21, 0x30, 0x09, 0x06, 0x05, 0x2b, 0x0e, 0x03, 0x02, 0x1a, 0x05, 0x00,
+            0x04, 0x14
+        )
+    }
+}
+
+/** One ADB connection holding one interactive shell, for writing `input keyevent` lines. */
+/**
+ * One ADB stream: an interactive shell by default, or another [service] such as
+ * `shell:logcat …`, whose output goes to [onOutput].
+ */
+class AdbShellConnection(
+    private val host: String,
+    val port: Int,
+    private val key: AdbKey,
+    private val service: String = "shell:",
+    private val onOutput: ((ByteArray) -> Unit)? = null,
+) : Closeable {
+
+    private lateinit var socket: Socket
+    private lateinit var input: DataInputStream
+    private lateinit var output: DataOutputStream
+    private val writeLock = Any()
+    private val credits = Semaphore(0)
+    private val localId = 1
+    @Volatile private var remoteId = 0
+
+    @Volatile
+    var isOpen = false
+        private set
+
+    /** [authTimeoutMs] covers the "Allow USB debugging?" prompt a new key gets on plain ADB. */
+    fun connect(authTimeoutMs: Int) {
+        val plain = Socket()
+        plain.tcpNoDelay = true
+        plain.connect(InetSocketAddress(host, port), 3000)
+        plain.soTimeout = authTimeoutMs
+        socket = plain
+        input = DataInputStream(plain.getInputStream())
+        output = DataOutputStream(plain.getOutputStream())
+
+        write(A_CNXN, A_VERSION, A_MAXDATA, "host::\u0000".toByteArray())
+        var message = read()
+        if (message.command == A_STLS) {
+            write(A_STLS, A_STLS_VERSION, 0, null)
+            val tls = key.sslContext.socketFactory.createSocket(plain, host, port, true) as SSLSocket
+            tls.soTimeout = authTimeoutMs
+            tls.startHandshake()
+            socket = tls
+            input = DataInputStream(tls.inputStream)
+            output = DataOutputStream(tls.outputStream)
+            message = read()
+        } else if (message.command == A_AUTH && message.arg0 == ADB_AUTH_TOKEN) {
+            write(A_AUTH, ADB_AUTH_SIGNATURE, 0, key.sign(message.data))
+            message = read()
+            if (message.command == A_AUTH) {
+                // Key not known yet: the TV now asks "Allow USB debugging?".
+                write(A_AUTH, ADB_AUTH_RSAPUBLICKEY, 0, key.adbPublicKey)
+                message = read()
+            }
+        }
+        if (message.command != A_CNXN) throw IOException("ADB did not accept the connection")
+
+        write(A_OPEN, localId, 0, "$service\u0000".toByteArray())
+        message = read()
+        if (message.command != A_OKAY) throw IOException("ADB refused to open $service")
+        remoteId = message.arg0
+        credits.release()
+        socket.soTimeout = 0
+        isOpen = true
+        Thread({ readLoop() }, "AdbShellReader").apply { isDaemon = true }.start()
+    }
+
+    fun sendLine(line: String) {
+        if (!isOpen) throw IOException("ADB shell is closed")
+        // adbd allows one unacknowledged write per stream.
+        if (!credits.tryAcquire(2, TimeUnit.SECONDS)) throw IOException("ADB shell did not acknowledge")
+        if (!isOpen) throw IOException("ADB shell is closed")
+        write(A_WRTE, localId, remoteId, line.toByteArray())
+    }
+
+    private fun readLoop() {
+        try {
+            while (isOpen) {
+                val message = read()
+                when (message.command) {
+                    A_OKAY -> credits.release()
+                    A_WRTE -> {
+                        onOutput?.invoke(message.data) // an interactive shell's echo is ignored
+                        write(A_OKAY, localId, remoteId, null)
+                    }
+                    A_CLSE -> break
+                }
+            }
+        } catch (e: Exception) {
+            if (isOpen) Log.w("AdbShellConnection", "ADB connection lost: ${e.message}")
+        }
+        close()
+    }
+
+    private fun write(command: Int, arg0: Int, arg1: Int, data: ByteArray?) {
+        val payload = data ?: ByteArray(0)
+        val buffer = ByteBuffer.allocate(24 + payload.size).order(ByteOrder.LITTLE_ENDIAN)
+        buffer.putInt(command)
+        buffer.putInt(arg0)
+        buffer.putInt(arg1)
+        buffer.putInt(payload.size)
+        buffer.putInt(payload.sumOf { it.toInt() and 0xff })
+        buffer.putInt(command.inv())
+        buffer.put(payload)
+        synchronized(writeLock) {
+            output.write(buffer.array())
+            output.flush()
+        }
+    }
+
+    private class Message(val command: Int, val arg0: Int, val data: ByteArray)
+
+    private fun read(): Message {
+        val header = ByteArray(24)
+        input.readFully(header)
+        val buffer = ByteBuffer.wrap(header).order(ByteOrder.LITTLE_ENDIAN)
+        val command = buffer.int
+        val arg0 = buffer.int
+        buffer.int // arg1
+        val length = buffer.int
+        buffer.int // checksum, no longer sent by current adbd
+        val magic = buffer.int
+        if (magic != command.inv() || length < 0 || length > 1024 * 1024) {
+            throw IOException("bad ADB message")
+        }
+        val data = ByteArray(length)
+        input.readFully(data)
+        return Message(command, arg0, data)
+    }
+
+    override fun close() {
+        isOpen = false
+        credits.release()
+        try {
+            socket.close()
+        } catch (_: Exception) {}
+    }
+}
+
+object AdbMdns {
+    /** Port of this device's own Wireless debugging service, or -1 if none shows up in time. */
+    fun findTlsPort(context: Context, timeoutMs: Long): Int {
+        val nsd = context.getSystemService(NsdManager::class.java) ?: return -1
+        val localAddresses = try {
+            NetworkInterface.getNetworkInterfaces().asSequence()
+                .flatMap { it.inetAddresses.asSequence() }
+                .mapNotNull { it.hostAddress }
+                .toSet()
+        } catch (e: Exception) {
+            emptySet()
+        }
+        val latch = CountDownLatch(1)
+        var port = -1
+
+        val listener = object : NsdManager.DiscoveryListener {
+            override fun onDiscoveryStarted(serviceType: String) {}
+            override fun onDiscoveryStopped(serviceType: String) {}
+            override fun onStartDiscoveryFailed(serviceType: String, errorCode: Int) = latch.countDown()
+            override fun onStopDiscoveryFailed(serviceType: String, errorCode: Int) {}
+            override fun onServiceLost(serviceInfo: NsdServiceInfo) {}
+            override fun onServiceFound(serviceInfo: NsdServiceInfo) {
+                @Suppress("DEPRECATION")
+                nsd.resolveService(serviceInfo, object : NsdManager.ResolveListener {
+                    override fun onResolveFailed(serviceInfo: NsdServiceInfo, errorCode: Int) {}
+                    override fun onServiceResolved(info: NsdServiceInfo) {
+                        if (info.host?.hostAddress in localAddresses) {
+                            port = info.port
+                            latch.countDown()
+                        }
+                    }
+                })
+            }
+        }
+
+        try {
+            nsd.discoverServices("_adb-tls-connect._tcp", NsdManager.PROTOCOL_DNS_SD, listener)
+            latch.await(timeoutMs, TimeUnit.MILLISECONDS)
+        } catch (e: Exception) {
+            Log.w("AdbMdns", "Wireless debugging lookup failed: ${e.message}")
+        } finally {
+            try {
+                nsd.stopServiceDiscovery(listener)
+            } catch (_: Exception) {}
+        }
+        return port
+    }
+}
+
+private const val ANDROID_PUBKEY_MODULUS_SIZE = 2048 / 8
+private const val ANDROID_PUBKEY_MODULUS_SIZE_WORDS = ANDROID_PUBKEY_MODULUS_SIZE / 4
+
+private fun BigInteger.toAdbEncoded(): IntArray {
+    // little-endian 32-bit words
+    val encoded = IntArray(ANDROID_PUBKEY_MODULUS_SIZE_WORDS)
+    val r32 = BigInteger.ZERO.setBit(32)
+    var tmp = this
+    for (i in 0 until ANDROID_PUBKEY_MODULUS_SIZE_WORDS) {
+        val out = tmp.divideAndRemainder(r32)
+        tmp = out[0]
+        encoded[i] = out[1].toInt()
+    }
+    return encoded
+}
+
+// The format adbd keeps in adb_keys (system/core/libcrypto_utils/android_pubkey.c).
+private fun RSAPublicKey.adbEncoded(name: String): ByteArray {
+    val r32 = BigInteger.ZERO.setBit(32)
+    val n0inv = modulus.remainder(r32).modInverse(r32).negate()
+    val r = BigInteger.ZERO.setBit(ANDROID_PUBKEY_MODULUS_SIZE * 8)
+    val rr = r.modPow(BigInteger.valueOf(2), modulus)
+
+    val buffer = ByteBuffer.allocate(524).order(ByteOrder.LITTLE_ENDIAN)
+    buffer.putInt(ANDROID_PUBKEY_MODULUS_SIZE_WORDS)
+    buffer.putInt(n0inv.toInt())
+    modulus.toAdbEncoded().forEach { buffer.putInt(it) }
+    rr.toAdbEncoded().forEach { buffer.putInt(it) }
+    buffer.putInt(publicExponent.toInt())
+
