diff --git a/android-tv/app/src/main/java/com/corvofeng/fakeatv/Bonjour.kt b/android-tv/app/src/main/java/com/corvofeng/fakeatv/Bonjour.kt
new file mode 100644
index 0000000..8b9c0d0
--- /dev/null
+++ b/android-tv/app/src/main/java/com/corvofeng/fakeatv/Bonjour.kt
@@ -0,0 +1,313 @@
+package com.corvofeng.fakeatv
+
+import android.content.Context
+import android.util.Log
+import java.io.ByteArrayOutputStream
+import java.net.Inet4Address
+import java.net.InetAddress
+import java.net.InetSocketAddress
+import java.net.NetworkInterface
+import java.net.StandardProtocolFamily
+import java.net.StandardSocketOptions
+import java.nio.ByteBuffer
+import java.nio.channels.DatagramChannel
+import java.nio.channels.SelectionKey
+import java.nio.channels.Selector
+
+/**
+ * A small mDNS responder for the server's Bonjour services, on Wi-Fi over IPv4.
+ *
+ * On the DPL panel neither Android's own responder (NsdManager) nor the native mdns-sd library kept
+ * "Gupta's TV" in iPhones' Remote list: NsdManager answered iPhones' multicast queries only some of the
+ * time and handed out the panel's rotating temporary IPv6 addresses, and mdns-sd sent nothing on Wi-Fi.
+ * This responder answers every query for our names (multicast, QU and plain unicast), always with the
+ * current Wi-Fi IPv4 address, under a host name of its own, and announces the services at start and
+ * every [ANNOUNCE_MS] after that.
+ */
+object Bonjour {
+    private const val TAG = "Bonjour"
+    private const val PORT = 5353
+    private const val ANNOUNCE_MS = 60_000L
+    private const val REPORT_MS = 10 * 60_000L
+    private const val TTL_SERVICE = 4500
+    private const val TTL_HOST = 120
+    private const val TYPE_A = 1
+    private const val TYPE_PTR = 12
+    private const val TYPE_TXT = 16
+    private const val TYPE_SRV = 33
+    private const val TYPE_ANY = 255
+    private const val CACHE_FLUSH = 0x8000
+    private const val SERVICES = "_services._dns-sd._udp.local"
+    private val GROUP: InetAddress = InetAddress.getByName("224.0.0.251")
+    private val GROUP6: InetAddress = InetAddress.getByName("ff02::fb")
+
+    private class Service(val type: String, val instance: String, val port: Int, val txt: List<String>)
+
+    private data class Rec(val name: String, val type: Int, val ttl: Int, val rdata: ByteArray, val flush: Boolean = false) {
+        override fun equals(other: Any?) =
+            other is Rec && name == other.name && type == other.type && rdata.contentEquals(other.rdata)
+        override fun hashCode() = name.hashCode() * 31 + type
+    }
+
+    @Volatile private var running = false
+    private var sockets: List<DatagramChannel> = emptyList()
+
+    @Synchronized
+    fun register(context: Context, name: String) {
+        unregister(context)
+        val services = AtvNative.nativeBonjourServices().lines().filter { it.isNotBlank() }.map { line ->
+            val fields = line.split('\t')
+            val type = fields[0].trimEnd('.').removeSuffix(".local") + ".local"
+            Service(type, "$name.$type", fields[1].toInt(), fields.drop(2))
+        }
+        if (services.isEmpty()) return
+        // "Gupta's TV" -> "Guptas-TV-Remote.local": a host name of its own, not the generic Android.local.
+        val label = name.replace(' ', '-').filter { it.isLetterOrDigit() || it == '-' }.trim('-')
+        running = true
+        Thread({ serve(services, "$label-Remote.local") }, "bonjour").apply { isDaemon = true; start() }
+    }
+
+    @Synchronized
+    fun unregister(@Suppress("UNUSED_PARAMETER") context: Context) {
+        running = false
+        sockets.forEach { try { it.close() } catch (_: Exception) {} }
+        sockets = emptyList()
+    }
+
+    private fun serve(services: List<Service>, host: String) {
+        val wifi = wifiInterface()
+        // One IPv4 and one IPv6 socket, each joined on Wi-Fi: iPhones ask over both. (Java's default
+        // MulticastSocket is dual-stack on Android, and its join of the IPv4 group never delivered IPv4 queries.)
+        // Both answer with the IPv4 address only.
+        val selector = Selector.open()
+        val opened = mutableListOf<DatagramChannel>()
+        for ((family, any, group) in listOf(
+            Triple(StandardProtocolFamily.INET, InetAddress.getByName("0.0.0.0"), GROUP),
+            Triple(StandardProtocolFamily.INET6, InetAddress.getByName("::"), GROUP6),
+        )) {
+            try {
+                val channel = DatagramChannel.open(family).apply {
+                    setOption(StandardSocketOptions.SO_REUSEADDR, true)
+                    bind(InetSocketAddress(any, PORT))
+                    setOption(StandardSocketOptions.IP_MULTICAST_TTL, 255)
+                    if (wifi != null) {
+                        setOption(StandardSocketOptions.IP_MULTICAST_IF, wifi)
+                        join(group, wifi)
+                    }
+                    configureBlocking(false)
+                }
+                channel.register(selector, SelectionKey.OP_READ, group)
+                opened += channel
+            } catch (e: Exception) {
+                Log.w(TAG, "Could not open the $family mDNS socket: $e")
+            }
+        }
+        if (opened.isEmpty()) {
+            selector.close()
+            return
+        }
+        synchronized(this) { sockets = opened }
+        Log.i(TAG, "Answering for ${services.map { it.instance }} as $host on ${wifi?.name ?: "default"}")
+        var nextAnnounce = 0L
+        var announced = 0
+        var received = 0
+        var answered = 0
+        var nextReport = System.currentTimeMillis() + REPORT_MS
+        val buffer = ByteBuffer.allocate(9000)
+        while (running) {
+            val now = System.currentTimeMillis()
+            if (now >= nextAnnounce) {
+                ipv4()?.let { ip ->
+                    val bytes = message(0, announcement(services, host, ip), false)
+                    for (key in selector.keys()) send(key.channel() as DatagramChannel, bytes, key.attachment() as InetAddress, PORT)
+                }
+                announced++
+                // Three announcements a second apart, then one a minute.
+                nextAnnounce = now + if (announced < 3) 1000 else ANNOUNCE_MS
+            }
+            if (now >= nextReport) {
+                Log.i(TAG, "Last ${REPORT_MS / 60_000} min: $received queries received, $answered answered")
+                received = 0; answered = 0; nextReport = now + REPORT_MS
+            }
+            try {
+                if (selector.select(1000) == 0) continue
+                val ready = selector.selectedKeys().toList()
+                selector.selectedKeys().clear()
+                for (key in ready) {
+                    val sock = key.channel() as DatagramChannel
+                    val group = key.attachment() as InetAddress
+                    while (true) {
+                        buffer.clear()
+                        val from = sock.receive(buffer) as? InetSocketAddress ?: break
+                        buffer.flip()
+                        val data = ByteArray(buffer.remaining()).also { buffer.get(it) }
+                        received++
+                        try {
+                            if (answer(sock, group, data, from, services, host)) answered++
+                        } catch (e: Exception) {
+                            Log.d(TAG, "Ignored an mDNS packet: $e")
+                        }
+                    }
+                }
+            } catch (e: Exception) {
+                if (running) Log.w(TAG, "mDNS receive failed: $e")
+                break
+            }
+        }
+        try { selector.close() } catch (_: Exception) {}
+        opened.forEach { try { it.close() } catch (_: Exception) {} }
+    }
+
+    /** Answers a query that asks about any of our names; ignores responses and everything else. */
+    private fun answer(sock: DatagramChannel, group: InetAddress, data: ByteArray, from: InetSocketAddress,
+                       services: List<Service>, host: String): Boolean {
+        if (data.size < 12 || (data[2].toInt() and 0x80) != 0) return false   // too short, or a response
+        val ip = ipv4() ?: return false
+        val records = LinkedHashSet<Rec>()
+        val asked = mutableListOf<String>()
+        var unicast = false
+        var offset = 12
+        repeat(u16(data, 4)) {
+            val (qname, next) = readName(data, offset)
+            val qtype = u16(data, next)
+            if ((u16(data, next + 2) and 0x8000) != 0) unicast = true
+            offset = next + 4
+            val name = qname.lowercase()
+            val any = qtype == TYPE_ANY
+            for (s in services) {
+                if (name == s.type.lowercase() && (qtype == TYPE_PTR || any)) {
+                    records += ptr(s); records += srv(s, host); records += txt(s); records += a(host, ip)
+                    asked += s.type
+                } else if (name == s.instance.lowercase() && (qtype == TYPE_SRV || qtype == TYPE_TXT || any)) {
+                    records += srv(s, host); records += txt(s); records += a(host, ip)
+                    asked += s.instance
+                } else if (name == SERVICES && (qtype == TYPE_PTR || any)) {
+                    records += Rec(SERVICES, TYPE_PTR, TTL_SERVICE, nameBytes(s.type))
+                }
+            }
+            if (name == host.lowercase() && (qtype == TYPE_A || any)) {
+                records += a(host, ip); asked += host
+            }
+        }
+        if (records.isEmpty()) return false
+        when {
+            // A plain DNS query sent to port 5353 (dig and the like): reply to its port with its ID.
+            from.port != PORT -> send(sock, message(u16(data, 0), records.toList(), true), from.address, from.port)
+            // "QU" questions want a unicast reply.
+            unicast -> send(sock, message(0, records.toList(), false), from.address, PORT)
+            else -> send(sock, message(0, records.toList(), false), group, PORT)
+        }
+        if (asked.isNotEmpty()) Log.i(TAG, "Answered ${from.address.hostAddress} for ${asked.distinct()}")
+        return true
+    }
+
+    private fun ptr(s: Service) = Rec(s.type, TYPE_PTR, TTL_SERVICE, nameBytes(s.instance))
+    private fun srv(s: Service, host: String) = Rec(s.instance, TYPE_SRV, TTL_HOST,
+        byteArrayOf(0, 0, 0, 0, (s.port shr 8).toByte(), s.port.toByte()) + nameBytes(host), flush = true)
+    private fun a(host: String, ip: Inet4Address) = Rec(host, TYPE_A, TTL_HOST, ip.address, flush = true)
+    private fun txt(s: Service): Rec {
+        val out = ByteArrayOutputStream()
+        for (entry in s.txt.ifEmpty { listOf("") }) {
+            val bytes = entry.toByteArray(Charsets.UTF_8).let { if (it.size > 255) it.copyOf(255) else it }
+            out.write(bytes.size); out.write(bytes)
+        }
+        return Rec(s.instance, TYPE_TXT, TTL_SERVICE, out.toByteArray(), flush = true)
+    }
+
+    private fun announcement(services: List<Service>, host: String, ip: Inet4Address): List<Rec> {
+        val records = mutableListOf<Rec>()
+        for (s in services) {
+            records += ptr(s); records += srv(s, host); records += txt(s)
+            records += Rec(SERVICES, TYPE_PTR, TTL_SERVICE, nameBytes(s.type))
+        }
+        records += a(host, ip)
+        return records
+    }
+
+    /** A response with every record in the answer section. */
+    private fun message(id: Int, records: List<Rec>, legacy: Boolean): ByteArray {
+        val out = ByteArrayOutputStream()
+        fun u16(v: Int) { out.write(v shr 8 and 0xFF); out.write(v and 0xFF) }
+        u16(id); u16(0x8400); u16(0); u16(records.size); u16(0); u16(0)
+        for (r in records) {
+            out.write(nameBytes(r.name))
+            u16(r.type)
+            // Replies to plain DNS queries carry no cache-flush bit and short TTLs (RFC 6762 §6.7).
+            u16(1 or if (r.flush && !legacy) CACHE_FLUSH else 0)
+            val ttl = if (legacy) minOf(r.ttl, 10) else r.ttl
+            u16(ttl ushr 16); u16(ttl and 0xFFFF)
+            u16(r.rdata.size)
+            out.write(r.rdata)
+        }
+        return out.toByteArray()
+    }
+
+    private fun send(sock: DatagramChannel, bytes: ByteArray, to: InetAddress, port: Int) {
+        try {
+            sock.send(ByteBuffer.wrap(bytes), InetSocketAddress(to, port))
+        } catch (e: Exception) {
+            Log.w(TAG, "mDNS send to ${to.hostAddress} failed: $e")
+        }
+    }
+
+    private fun nameBytes(name: String): ByteArray {
+        val out = ByteArrayOutputStream()
+        for (label in splitName(name)) {
+            val bytes = label.toByteArray(Charsets.UTF_8)
+            out.write(bytes.size); out.write(bytes)
+        }
+        out.write(0)
+        return out.toByteArray()
+    }
+
+    /** "Gupta's TV._companion-link._tcp.local" -> ["Gupta's TV", "_companion-link", "_tcp", "local"]. */
+    private fun splitName(name: String): List<String> {
+        val service = Regex("^(.+?)\\.(_[^.]+\\._(?:tcp|udp)\\.local)$").find(name)
+        return if (service != null && !service.groupValues[1].startsWith("_")) {
+            listOf(service.groupValues[1]) + service.groupValues[2].split('.')
+        } else {
+            name.split('.')
+        }
+    }
+
+    private fun readName(data: ByteArray, start: Int): Pair<String, Int> {
+        val labels = mutableListOf<String>()
+        var offset = start
+        var end = -1
+        var jumps = 0
+        while (true) {
+            val len = data[offset].toInt() and 0xFF
+            when {
+                len == 0 -> { offset++; break }
+                (len and 0xC0) == 0xC0 -> {
+                    if (end < 0) end = offset + 2
+                    offset = ((len and 0x3F) shl 8) or (data[offset + 1].toInt() and 0xFF)
+                    require(++jumps <= 20) { "name loop" }
+                }
+                else -> {
+                    labels += String(data, offset + 1, len, Charsets.UTF_8)
+                    offset += 1 + len
+                }
+            }
+        }
+        return labels.joinToString(".") to (if (end >= 0) end else offset)
+    }
+
+    private fun u16(data: ByteArray, at: Int) = ((data[at].toInt() and 0xFF) shl 8) or (data[at + 1].toInt() and 0xFF)
+
+    private fun wifiInterface(): NetworkInterface? = try {
+        NetworkInterface.getByName("wlan0")
+            ?: NetworkInterface.getNetworkInterfaces().toList().firstOrNull { nif ->
+                nif.isUp && !nif.isLoopback && nif.inetAddresses.toList().any { it is Inet4Address && it.isSiteLocalAddress }
+            }
+    } catch (_: Exception) {
+        null
+    }
+
+    /** The Wi-Fi interface's current IPv4 address, read fresh for every answer. */
+    private fun ipv4(): Inet4Address? = try {
+        wifiInterface()?.inetAddresses?.toList()?.filterIsInstance<Inet4Address>()?.firstOrNull { !it.isLoopbackAddress }
+    } catch (_: Exception) {
+        null
+    }
+}
