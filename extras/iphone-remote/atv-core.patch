@@ -0,0 +1,61 @@
+package com.corvofeng.fakeatv
+
+import android.util.Log
+import java.util.concurrent.atomic.AtomicBoolean
+
+/**
+ * YouTube draws its own keyboard, so Accessibility never sees a text field there. Its log does
+ * say where it is ("Navigated to https://www.youtube.com/tv#/search?..."), so this follows that
+ * one line over local ADB and opens the iPhone keyboard while YouTube's search is showing.
+ * Only the route is read; URLs are never logged.
+ */
+object YouTubeSearchWatcher {
+    private const val TAG = "YouTubeSearchWatcher"
+    private const val MARKER = "Navigated to https://www.youtube.com/tv#/"
+    // The whole buffer first, so the last route YouTube logged sets the starting state.
+    private const val SERVICE = "shell:logcat -v raw -s cobalt:I | grep --line-buffered 'Navigated to '"
+
+    private val running = AtomicBoolean(false)
+
+    fun start() {
+        if (!running.compareAndSet(false, true)) return
+        Thread({ run() }, "YouTubeSearchWatcher").apply { isDaemon = true }.start()
+    }
+
+    private fun run() {
+        try {
+            // Retry while the key shell is up; when it drops, its reconnect starts this again.
+            while (LocalAdbDriver.isConnected.get()) {
+                watchOnce()
+                AtvAccessibilityService.instance?.setYouTubeSearch(false)
+                Thread.sleep(5000)
+            }
+        } catch (_: InterruptedException) {
+        } finally {
+            running.set(false)
+        }
+    }
+
+    private fun watchOnce() {
+        val pending = StringBuilder()
+        val stream = LocalAdbDriver.openStream(SERVICE) { data ->
+            pending.append(String(data, Charsets.UTF_8))
+            while (true) {
+                val end = pending.indexOf('\n')
+                if (end < 0) break
+                onLine(pending.substring(0, end))
+                pending.delete(0, end + 1)
+            }
+        } ?: return
+        Log.i(TAG, "Watching YouTube's search screen")
+        while (stream.isOpen) Thread.sleep(1000)
+        Log.i(TAG, "Stopped watching YouTube")
+    }
+
+    private fun onLine(line: String) {
+        val at = line.indexOf(MARKER)
+        if (at < 0) return
+        val search = line.startsWith("search", at + MARKER.length)
+        AtvAccessibilityService.instance?.setYouTubeSearch(search)
+    }
+}
