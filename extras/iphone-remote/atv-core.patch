+package com.corvofeng.fakeatv
+
+import android.content.Context
+import android.graphics.Canvas
+import android.graphics.Color
+import android.graphics.Paint
+import android.graphics.Path
+import android.graphics.PixelFormat
+import android.view.Gravity
+import android.view.View
+import android.view.WindowManager
+
+/**
+ * The cursor arrow for cursor mode (TV button held on the iPhone remote). Drawn as an
+ * Accessibility overlay that never takes touches, so taps at its tip reach the app below.
+ * Call from the main thread.
+ */
+class CursorOverlay(private val context: Context, private val size: Int) {
+    private val wm = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager
+    private var view: View? = null
+    private val params = WindowManager.LayoutParams(
+        size, size,
+        WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY,
+        WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or
+            WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or
+            WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or
+            WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
+        PixelFormat.TRANSLUCENT
+    ).apply { gravity = Gravity.TOP or Gravity.START }
+
+    val isShown: Boolean
+        get() = view != null
+
+    fun show(x: Float, y: Float) {
+        if (view == null) {
+            val arrow = ArrowView(context)
+            place(x, y)
+            wm.addView(arrow, params)
+            view = arrow
+        } else {
+            moveTo(x, y)
+        }
+    }
+
+    fun moveTo(x: Float, y: Float) {
+        val v = view ?: return
+        place(x, y)
+        wm.updateViewLayout(v, params)
+    }
+
+    fun hide() {
+        view?.let { wm.removeView(it) }
+        view = null
+    }
+
+    // The arrow's tip is the view's top-left corner.
+    private fun place(x: Float, y: Float) {
+        params.x = x.toInt()
+        params.y = y.toInt()
+    }
+
+    private class ArrowView(context: Context) : View(context) {
+        private val fill = Paint(Paint.ANTI_ALIAS_FLAG).apply { color = Color.WHITE }
+        private val outline = Paint(Paint.ANTI_ALIAS_FLAG).apply {
+            color = Color.BLACK
+            style = Paint.Style.STROKE
+            strokeJoin = Paint.Join.ROUND
+        }
+        private val path = Path()
+
+        override fun onDraw(canvas: Canvas) {
+            val s = width.toFloat()
+            outline.strokeWidth = s / 16
+            val m = outline.strokeWidth
+            path.reset()
+            path.moveTo(m, m)
+            path.lineTo(m, s * 0.85f)
+            path.lineTo(s * 0.32f, s * 0.64f)
+            path.lineTo(s * 0.5f, s - m)
+            path.lineTo(s * 0.64f, s * 0.92f)
+            path.lineTo(s * 0.47f, s * 0.58f)
+            path.lineTo(s * 0.78f, s * 0.58f)
+            path.close()
+            canvas.drawPath(path, fill)
+            canvas.drawPath(path, outline)
+        }
+    }
+}
