new file mode 100644
index 0000000..97805d6
--- /dev/null
+++ b/crates/atv-core/src/text_input.rs
@@ -0,0 +1,362 @@
+//! Remote Text Input: the keyboard the Apple TV Remote shows when a text field on the TV is focused.
+//!
+//! The TV announces a focused field with a `_tiStarted` event (and answers `_tiStart`) carrying
+//! `_tiD`, an NSKeyedArchiver archive of the field's `RTIDocumentTraits`, `RTIDocumentState` and a
+//! session UUID. The iPhone then sends `_tiC` events whose archive holds `RTITextOperations`:
+//! inserted text, a delete count, or the whole text to assert. `_tiStopped` ends the session.
+//! The archive layout follows what a real Apple TV sends (keys and classes only; values are ours).
+
+use plist::{Dictionary, Uid, Value};
+
+/// A text field the TV reported as focused.
+#[derive(Debug, Clone, PartialEq)]
+pub struct TextFocus {
+    pub session_uuid: [u8; 16],
+    pub text: String,
+}
+
+/// What the iPhone typed, from one `_tiC` event.
+#[derive(Debug, Default, Clone, PartialEq)]
+pub struct TextOperation {
+    pub session_uuid: Option<Vec<u8>>,
+    pub insertion: String,
+    pub deletion_count: u64,
+    pub text_to_assert: Option<String>,
+    /// Key names in the operation and its keyboard output (never their values), to spot
+    /// operation kinds this decoder does not read.
+    pub fields: Vec<String>,
+}
+
+/// Builds the `$objects` table of a keyed archive; index 0 is `$null`.
+struct Archive {
+    objects: Vec<Value>,
+}
+
+impl Archive {
+    fn new() -> Self {
+        Self { objects: vec![Value::String("$null".into())] }
+    }
+
+    fn add(&mut self, value: Value) -> Value {
+        self.objects.push(value);
+        Value::Uid(Uid::new((self.objects.len() - 1) as u64))
+    }
+
+    /// Reserve a slot to fill later, so a parent can be added before its children.
+    fn reserve(&mut self) -> (usize, Value) {
+        self.objects.push(Value::String("$null".into()));
+        let index = self.objects.len() - 1;
+        (index, Value::Uid(Uid::new(index as u64)))
+    }
+
+    fn class(&mut self, name: &str, extra: &[&str]) -> Value {
+        let mut classes = vec![Value::String(name.into())];
+        classes.extend(extra.iter().map(|c| Value::String((*c).into())));
+        classes.push(Value::String("NSObject".into()));
+        self.add(dict(vec![
+            ("$classname", Value::String(name.into())),
+            ("$classes", Value::Array(classes)),
+        ]))
+    }
+
+    fn finish(self, top: Vec<(&str, Value)>) -> Vec<u8> {
+        let archive = dict(vec![
+            ("$version", Value::Integer(100000.into())),
+            ("$archiver", Value::String("NSKeyedArchiver".into())),
+            ("$top", dict(top)),
+            ("$objects", Value::Array(self.objects)),
+        ]);
+        let mut out = Vec::new();
+        archive.to_writer_binary(&mut out).expect("writing to a Vec cannot fail");
+        out
+    }
+}
+
+fn dict(entries: Vec<(&str, Value)>) -> Value {
+    let mut d = Dictionary::new();
+    for (k, v) in entries {
+        d.insert(k.to_string(), v);
+    }
+    Value::Dictionary(d)
+}
+
+/// `_tiD` for `_tiStarted` and the `_tiStart` response: a focused search field holding `focus.text`.
+pub fn encode_session(focus: &TextFocus) -> Vec<u8> {
+    let mut a = Archive::new();
+
+    // RTIDocumentState { docSt: TIDocumentState { contextBeforeInput } }
+    let (doc_state_index, doc_state) = a.reserve();
+    let mut ti_doc_state = Dictionary::new();
+    if !focus.text.is_empty() {
+        let text = a.add(Value::String(focus.text.clone()));
+        ti_doc_state.insert("contextBeforeInput".into(), text);
+    }
+    let ti_doc_state_class = a.class("TIDocumentState", &[]);
+    ti_doc_state.insert("$class".into(), ti_doc_state_class);
+    let ti_doc_state = a.add(Value::Dictionary(ti_doc_state));
+    let doc_state_class = a.class("RTIDocumentState", &[]);
+    a.objects[doc_state_index] = dict(vec![
+        ("docSt", ti_doc_state),
+        ("originatedFromSource", Value::Boolean(false)),
+        ("$class", doc_state_class),
+    ]);
+
+    // RTIDocumentTraits for a search field that accepts the iPhone keyboard.
+    let app_id = a.add(Value::String(String::new()));
+    let bundle_id = a.add(Value::String("com.apple.TVWatchList".into()));
+    let app_name = a.add(Value::String("TV".into()));
+    let traits_class = a.class("TITextInputTraits", &[]);
+    let ti_traits = a.add(dict(vec![
+        ("flags", Value::Integer(1417693830.into())),
+        ("auxFlags", Value::Integer(1.into())),
+        ("version", Value::Integer(2.into())),
+        ("$class", traits_class),
+    ]));
+    let user_info = encode_user_info(&mut a);
+    let doc_traits_class = a.class("RTIDocumentTraits", &[]);
+    let doc_traits = a.add(dict(vec![
+        ("aId", app_id),
+        ("bId", bundle_id),
+        ("locApp", app_name),
+        ("a2bId", Value::Boolean(true)),
+        ("tiTraits", ti_traits),
+        ("ctxId", Value::Integer(1.into())),
+        ("cfmType", Value::Integer(87.into())),
+        ("layerId", Value::Integer(1.into())),
+        ("traitsMask", Value::Integer(576.into())),
+        ("userInfo", user_info),
+        ("$class", doc_traits_class),
+    ]));
+
+    let session_uuid = a.add(Value::Data(focus.session_uuid.to_vec()));
+    a.finish(vec![
+        ("documentTraits", doc_traits),
+        ("sessionUUID", session_uuid),
+        ("documentState", doc_state),
+    ])
+}
+
+/// The keyboard options a real Apple TV search field sends, value for value.
+fn encode_user_info(a: &mut Archive) -> Value {
+    let no = a.add(Value::Boolean(false));
+    let yes = a.add(Value::Boolean(true));
+    let zero = a.add(Value::Integer(0.into()));
+    let delegate = a.add(Value::String("UISearchBarTextField".into()));
+    let disabled_key = a.add(Value::String("disabled".into()));
+    let dict_class = a.class("NSDictionary", &[]);
+    let first_responder = a.add(dict(vec![
+        ("NS.keys", Value::Array(vec![disabled_key])),
+        ("NS.objects", Value::Array(vec![zero.clone()])),
+        ("$class", dict_class.clone()),
+    ]));
+    let entries: Vec<(&str, Value)> = vec![
+        ("ShouldSuppressSoftwareKeyboard", no.clone()),
+        ("ShouldSuppressSoftwareKeyboardForKeyboardCamera", no.clone()),
+        ("RTIInputDelegateClassName", delegate),
+        ("UseAutomaticEndpointing", no.clone()),
+        ("ReturnKeyEnabled", no.clone()),
+        ("ShouldUseDictationSearchFieldBehavior", zero.clone()),
+        ("SuppressSoftwareKeyboard", no.clone()),
+        ("ForceFloatingKeyboard", no.clone()),
+        ("HasCustomInputViewController", no.clone()),
+        ("CorrectionLearningAllowed", yes),
+        ("SuppressAssistantBar", no.clone()),
+        ("ForceDisableDictation", no.clone()),
+        ("ForceEnableDictation", no.clone()),
+        ("HasNextKeyResponder", zero.clone()),
+        ("InputViewHiddenCount", zero.clone()),
+        ("DisableBecomeFirstResponder", first_responder),
+        ("HasPreviousKeyResponder", zero),
+        ("AcceptsDictationResults", no),
+    ];
+    let mut keys = Vec::new();
+    let mut values = Vec::new();
+    for (k, v) in entries {
+        keys.push(a.add(Value::String(k.into())));
+        values.push(v);
+    }
+    a.add(dict(vec![
+        ("NS.keys", Value::Array(keys)),
+        ("NS.objects", Value::Array(values)),
+        ("$class", dict_class),
+    ]))
+}
+
+/// Read the `RTITextOperations` archive of a `_tiC` event.
+pub fn decode_operation(data: &[u8]) -> Option<TextOperation> {
+    let archive = Value::from_reader(std::io::Cursor::new(data)).ok()?;
+    let archive = archive.as_dictionary()?;
+    let objects = archive.get("$objects")?.as_array()?;
+    let resolve = |v: &Value| -> Option<Value> {
+        match v {
+            Value::Uid(uid) => objects.get(uid.get() as usize).cloned(),
+            other => Some(other.clone()),
+        }
+    };
+    let top = archive.get("$top")?.as_dictionary()?;
+    let ops = resolve(top.get("textOperations")?)?;
+    let ops = ops.as_dictionary()?;
+
+    let mut op = TextOperation::default();
+    let names = |d: &Dictionary| d.keys().filter(|k| *k != "$class").cloned().collect::<Vec<_>>();
+    op.fields = names(ops);
+    if let Some(uuid) = ops.get("targetSessionUUID").and_then(|v| resolve(v)) {
+        op.session_uuid = uuid
+            .as_dictionary()
+            .and_then(|d| d.get("NS.uuidbytes"))
+            .and_then(|b| b.as_data())
+            .map(|b| b.to_vec());
+    }
+    if let Some(output) = ops.get("keyboardOutput").and_then(|v| resolve(v)) {
+        if let Some(output) = output.as_dictionary() {
+            op.fields.extend(names(output).into_iter().map(|k| format!("keyboardOutput.{k}")));
+            if let Some(text) = output.get("insertionText").and_then(|v| resolve(v)) {
+                op.insertion = text.as_string().unwrap_or_default().to_string();
+            }
+            if let Some(count) = output.get("deletionCount").and_then(|v| resolve(v)) {
+                op.deletion_count = count.as_unsigned_integer().unwrap_or(0);
+            }
+            // A QuickType suggestion or autocorrection: `candidate` replaces the typed `input`.
+            if let Some(candidate) = output.get("acceptedCandidate").and_then(|v| resolve(v)) {
+                if let Some(candidate) = candidate.as_dictionary() {
+                    let text = |key: &str| {
+                        candidate
+                            .get(key)
+                            .and_then(|v| resolve(v))
+                            .and_then(|v| v.as_string().map(str::to_string))
+                    };
+                    for k in names(candidate) {
+                        let len = text(&k).map(|t| format!("={}", t.chars().count())).unwrap_or_default();
+                        op.fields.push(format!("acceptedCandidate.{k}{len}"));
+                    }
+                    if let Some(replacement) = text("candidate") {
+                        let typed = text("input").unwrap_or_default();
+                        op.deletion_count += typed.chars().count() as u64;
+                        op.insertion.push_str(&replacement);
+                    }
+                }
+            }
+        }
+    }
+    if let Some(text) = ops.get("textToAssert").and_then(|v| resolve(v)) {
+        op.text_to_assert = text.as_string().map(str::to_string);
+    }
+    Some(op)
+}
